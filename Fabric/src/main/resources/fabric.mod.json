{
	"schemaVersion": 1,
	"id": "tinyfarmbossaddon",
	"version": "${version}",
	"name": "Tiny Farm Boss Addon",
	"description": "Addon para Tiny Mob Farm que permite capturar bosses (Wither, Ender Dragon, Warden) y mobs complejos/modded (MineColonies, Ice and Fire, Slimes) de forma segura usando un Entity Crash Handler avanzado.",
	"authors": [
		"Tontoque28"
	],
	"contact": {
		"instagram": "Tontoque28"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.tontoque28.tinyfarmboss.TinyFarmBoss"
		]
	},
	"mixins": [
		"tinyfarmbossaddon.mixins.json",
		{
			"config": "tinyfarmbossaddon.client.mixins.json",
			"environment": "client"
		}
	],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}